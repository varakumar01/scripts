# Copy to scripts/.env on the build server (gitignored -- never commit the real file).
# otauploader.sh sources this automatically if it exists.

# Required for --pixeldrain/-pd. Get it from https://pixeldrain.com/user/api_keys
PIXELDRAIN_API_KEY=

# Optional. SourceForge sftp password for --sourceforge/-sf -- non-interactive
# auth via sshpass if set and sshpass is installed, else ssh prompts on the tty.
SSHPASS=

# Optional. How many ROM zips to keep per device/version dir on pixeldrain before
# --pixeldrain starts deleting the oldest ones. Default: 3.
PIXELDRAIN_RETENTION=3
